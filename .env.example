# Telegram: token from @BotFather, your own Telegram user id(s) for /admin and /refund
TELEGRAM_BOT_TOKEN=
ADMIN_IDS=
SUPPORT_CONTACT=@your_support
# Private bot: only ADMIN_IDS may use it (no payments), everyone else is refused
BOT_PRIVATE=0
# The owners' niche, set in their profile at start unless they chose one (e.g. Крипта и трейдинг)
OWNER_NICHE=

# Claude API
ANTHROPIC_API_KEY=
HOOKBOT_MODEL=claude-opus-5-5
HOOKBOT_EFFORT=medium
# Server-side fallback when a request is declined by a safety classifier: default | off
HOOKBOT_FALLBACKS=default

# Storage
HOOKBOT_DB=data/hookbot.db

# Business rules
FREE_CREDITS=5
RESULT_BONUS=1
# id:credits:stars, comma-separated
HOOKBOT_PACKS=start:15:200,pro:50:600,studio:150:1500
# Ask for real metrics this many hours after a hook is scored
FOLLOWUP_HOURS=48
# Rewrite the playbook after this many new results
REFLECT_EVERY=5
# Parallel Claude requests
MAX_CONCURRENT=4
LOG_LEVEL=INFO

# Instagram Graph API (business/creator account of the bot owner): own reels, skip rate,
# audience demographics, and Business Discovery of other creators
# How to get the token: docs/INSTAGRAM_SETUP.md; check it with `hookbot ig-check`
IG_ACCESS_TOKEN=
# Optional: found from the token unless several Instagram accounts are linked to it
IG_USER_ID=
IG_GRAPH_VERSION=v25.0

# Where Instagram data comes from: web (own collector, public data, no login — run it on a home IP; in the
# cloud set IG_WEB_PROXY to a residential proxy) | apify | graph. Empty: the token that is set decides.
IG_SOURCE=
# Seconds between requests of the own collector (with jitter); be polite, Instagram cools down fast readers
IG_WEB_MIN_INTERVAL=20
IG_WEB_PROXY=
# The niche grows on its own: creators read per cycle (0 = all), creators whose "related accounts" are
# explored per cycle, candidates checked per cycle, and the topic words a candidate's captions must contain
SCOUT_COLLECT_PER_CYCLE=0
SCOUT_EXPAND_PER_CYCLE=3
SCOUT_EXPAND_CHECKS=6
# Topic words come from each creator's niche in hookbot/core/data/niches.json; set these only to
# replace them for every niche:
# NICHE_KEYWORDS=крипт,биткоин,трейд,бирж

# No Facebook? Public Instagram data through Apify scrapers (apify.com → Settings → API & Integrations).
# Used when IG_ACCESS_TOKEN is empty: your public reels (plays, likes, comments, videos) and other creators'.
# Skip rate and saves are private: add them with `hookbot audit --csv` (docs/templates/my_reels.csv).
APIFY_TOKEN=
IG_USERNAME=
# Re-use scraped results for this long (each run is paid per result)
APIFY_CACHE_HOURS=12
# Apify transcripts cost ~$0.07 per reel (25× the reel itself); local Whisper (SCOUT_ASR=1) is free
APIFY_TRANSCRIPTS=0

# Scout: watches reels around the clock, studies viral vs typical ones, re-learns
SCOUT_ENABLED=0
SCOUT_INTERVAL_MINUTES=60
SCOUT_STUDY_PER_CYCLE=10
# Each studied reel is one Claude request with 6 frames (~$0.08–0.12)
SCOUT_DAILY_BUDGET=60
SCOUT_MEDIA_PER_ACCOUNT=25
# Web scan for fresh studies every N days (0 = off); found papers wait for /approve
SCOUT_LITERATURE_DAYS=7
# Workspace whose Instagram account the token belongs to (default: first admin)
SCOUT_OWN_WORKSPACE=
# Speech-to-text of the first seconds (pip install .[asr]; downloads a Whisper model)
SCOUT_ASR=0
HOOKBOT_WHISPER_MODEL=small
