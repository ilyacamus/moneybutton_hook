<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Autostart of the private Telegram bot on macOS. Replace REPO with the full path of the cloned repository, then:
     sed "s#REPO#$PWD#" scripts/macos/com.moneybutton.bot.plist > ~/Library/LaunchAgents/com.moneybutton.bot.plist
     launchctl load ~/Library/LaunchAgents/com.moneybutton.bot.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.moneybutton.bot</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>REPO/scripts/macos/run_bot.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardErrorPath</key><string>/tmp/moneybutton-bot.err</string>
</dict>
</plist>
