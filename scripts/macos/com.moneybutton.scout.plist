<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Autostart of the scout on macOS. Replace REPO with the full path of the cloned repository, then:
     cp scripts/macos/com.moneybutton.scout.plist ~/Library/LaunchAgents/
     launchctl load ~/Library/LaunchAgents/com.moneybutton.scout.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.moneybutton.scout</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>REPO/scripts/macos/run_scout.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>300</integer>
  <key>StandardErrorPath</key><string>/tmp/moneybutton-scout.err</string>
</dict>
</plist>
